{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "EasyCLIProxyAPI theme",
  "description": "A theme loaded from <app data>/themes/<folder>/theme.json.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "id",
    "name",
    "appearance",
    "windowBackground",
    "tokens"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "schemaVersion": {
      "const": 1
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{0,63}$"
    },
    "name": {
      "oneOf": [
        {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        {
          "type": "object",
          "minProperties": 1,
          "propertyNames": {
            "enum": [
              "zh-CN",
              "zh-TW",
              "ja",
              "en"
            ]
          },
          "additionalProperties": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80
          }
        }
      ]
    },
    "description": {
      "oneOf": [
        {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        {
          "type": "object",
          "minProperties": 1,
          "propertyNames": {
            "enum": [
              "zh-CN",
              "zh-TW",
              "ja",
              "en"
            ]
          },
          "additionalProperties": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80
          }
        }
      ]
    },
    "appearance": {
      "enum": [
        "light",
        "dark"
      ]
    },
    "windowBackground": {
      "type": "string",
      "pattern": "^#[0-9a-fA-F]{6}$"
    },
    "windowMaterial": {
      "enum": [
        "solid",
        "translucent"
      ]
    },
    "icon": {
      "type": "string",
      "description": "Relative path inside the theme folder to a png, jpg, jpeg, webp, svg or avif icon.",
      "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.?(?:/|$))(?!.*\\\\).+\\.(?:png|jpe?g|webp|svg|avif)$"
    },
    "assets": {
      "type": "object",
      "description": "Named relative paths inside the theme folder. backdropImage displays a PNG, JPEG, WebP or AVIF background (up to 8 MiB); other entries are reserved.",
      "propertyNames": {
        "pattern": "^[a-zA-Z][a-zA-Z0-9-]{0,31}$"
      },
      "additionalProperties": {
        "type": "string",
        "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.?(?:/|$))(?!.*\\\\).+\\.(?:png|jpe?g|webp|svg|avif)$"
      }
    },
    "backdrop": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "layers",
        "sidebar",
        "panel"
      ],
      "properties": {
        "layers": {
          "type": "array",
          "minItems": 1,
          "maxItems": 4,
          "items": {
            "type": "object",
            "required": [
              "kind",
              "stops"
            ],
            "properties": {
              "kind": {
                "enum": [
                  "linear",
                  "radial"
                ]
              },
              "angle": {
                "type": "number",
                "minimum": 0,
                "maximum": 360
              },
              "center": {
                "type": "array",
                "items": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 100
                },
                "minItems": 2,
                "maxItems": 2
              },
              "size": {
                "type": "array",
                "items": {
                  "type": "number",
                  "minimum": 1,
                  "maximum": 200
                },
                "minItems": 2,
                "maxItems": 2
              },
              "stops": {
                "type": "array",
                "minItems": 2,
                "maxItems": 8,
                "items": {
                  "type": "object",
                  "required": [
                    "color",
                    "at"
                  ],
                  "properties": {
                    "color": {
                      "type": "string",
                      "pattern": "^#(?:[0-9a-fA-F]{6}|[0-9a-fA-F]{8})$"
                    },
                    "at": {
                      "type": "number",
                      "minimum": 0,
                      "maximum": 100
                    }
                  },
                  "additionalProperties": false
                }
              }
            },
            "additionalProperties": false
          }
        },
        "sidebar": {
          "type": "string",
          "pattern": "^#(?:[0-9a-fA-F]{6}|[0-9a-fA-F]{8})$"
        },
        "panel": {
          "type": "string",
          "pattern": "^#(?:[0-9a-fA-F]{6}|[0-9a-fA-F]{8})$"
        },
        "inset": {
          "type": "string",
          "pattern": "^#(?:[0-9a-fA-F]{6}|[0-9a-fA-F]{8})$"
        },
        "hover": {
          "type": "string",
          "pattern": "^#(?:[0-9a-fA-F]{6}|[0-9a-fA-F]{8})$"
        },
        "imagePosition": {
          "type": "array",
          "items": {
            "type": "number",
            "minimum": 0,
            "maximum": 100
          },
          "minItems": 2,
          "maxItems": 2
        }
      }
    },
    "tokens": {
      "type": "object",
      "additionalProperties": false,
      "description": "Appearance tokens. Sizes, spacing, layout and typography are not themeable.",
      "properties": {
        "windowMaterialWorkspaceOpacity": {
          "type": "string",
          "pattern": "^(?:100(?:\\.0+)?|\\d{1,2}(?:\\.\\d+)?)%$",
          "description": "Percentage from 0% to 100%."
        },
        "windowMaterialSidebarOpacity": {
          "type": "string",
          "pattern": "^(?:100(?:\\.0+)?|\\d{1,2}(?:\\.\\d+)?)%$",
          "description": "Percentage from 0% to 100%."
        },
        "workspaceBackground": {
          "type": "string",
          "pattern": "^#(?:[0-9a-fA-F]{6}|[0-9a-fA-F]{8})$"
        },
        "surface": {
          "type": "string",
          "pattern": "^#(?:[0-9a-fA-F]{6}|[0-9a-fA-F]{8})$"
        },
        "softSurface": {
          "type": "string",
          "pattern": "^#(?:[0-9a-fA-F]{6}|[0-9a-fA-F]{8})$"
        },
        "hoverBackground": {
          "type": "string",
          "pattern": "^#(?:[0-9a-fA-F]{6}|[0-9a-fA-F]{8})$"
        },
        "textPrimary": {
          "type": "string",
          "pattern": "^#(?:[0-9a-fA-F]{6}|[0-9a-fA-F]{8})$"
        },
        "textSecondary": {
          "type": "string",
          "pattern": "^#(?:[0-9a-fA-F]{6}|[0-9a-fA-F]{8})$"
        },
        "textTertiary": {
          "type": "string",
          "pattern": "^#(?:[0-9a-fA-F]{6}|[0-9a-fA-F]{8})$"
        },
        "textMuted": {
          "type": "string",
          "pattern": "^#(?:[0-9a-fA-F]{6}|[0-9a-fA-F]{8})$"
        },
        "border": {
          "type": "string",
          "pattern": "^#(?:[0-9a-fA-F]{6}|[0-9a-fA-F]{8})$"
        },
        "borderSubtle": {
          "type": "string",
          "pattern": "^#(?:[0-9a-fA-F]{6}|[0-9a-fA-F]{8})$"
        },
        "borderStrong": {
          "type": "string",
          "pattern": "^#(?:[0-9a-fA-F]{6}|[0-9a-fA-F]{8})$"
        },
        "borderHover": {
          "type": "string",
          "pattern": "^#(?:[0-9a-fA-F]{6}|[0-9a-fA-F]{8})$"
        },
        "panelShadow": {
          "type": "string",
          "pattern": "^#(?:[0-9a-fA-F]{6}|[0-9a-fA-F]{8})$"
        },
        "accent": {
          "type": "string",
          "pattern": "^#(?:[0-9a-fA-F]{6}|[0-9a-fA-F]{8})$"
        },
        "accentStrong": {
          "type": "string",
          "pattern": "^#(?:[0-9a-fA-F]{6}|[0-9a-fA-F]{8})$"
        },
        "accentSoft": {
          "type": "string",
          "pattern": "^#(?:[0-9a-fA-F]{6}|[0-9a-fA-F]{8})$"
        },
        "accentContrast": {
          "type": "string",
          "pattern": "^#(?:[0-9a-fA-F]{6}|[0-9a-fA-F]{8})$"
        },
        "accentShadow": {
          "type": "string",
          "pattern": "^#(?:[0-9a-fA-F]{6}|[0-9a-fA-F]{8})$"
        },
        "focusRing": {
          "type": "string",
          "pattern": "^#(?:[0-9a-fA-F]{6}|[0-9a-fA-F]{8})$"
        },
        "meterLow": {
          "type": "string",
          "pattern": "^#(?:[0-9a-fA-F]{6}|[0-9a-fA-F]{8})$"
        },
        "meterMedium": {
          "type": "string",
          "pattern": "^#(?:[0-9a-fA-F]{6}|[0-9a-fA-F]{8})$"
        },
        "meterHigh": {
          "type": "string",
          "pattern": "^#(?:[0-9a-fA-F]{6}|[0-9a-fA-F]{8})$"
        },
        "primaryButtonBackground": {
          "type": "string",
          "pattern": "^#(?:[0-9a-fA-F]{6}|[0-9a-fA-F]{8})$"
        },
        "primaryButtonHoverBackground": {
          "type": "string",
          "pattern": "^#(?:[0-9a-fA-F]{6}|[0-9a-fA-F]{8})$"
        },
        "primaryButtonText": {
          "type": "string",
          "pattern": "^#(?:[0-9a-fA-F]{6}|[0-9a-fA-F]{8})$"
        },
        "primaryButtonBorder": {
          "type": "string",
          "pattern": "^#(?:[0-9a-fA-F]{6}|[0-9a-fA-F]{8})$"
        },
        "primaryButtonHoverBorder": {
          "type": "string",
          "pattern": "^#(?:[0-9a-fA-F]{6}|[0-9a-fA-F]{8})$"
        },
        "controlActiveBackground": {
          "type": "string",
          "pattern": "^#(?:[0-9a-fA-F]{6}|[0-9a-fA-F]{8})$"
        },
        "controlActiveThumb": {
          "type": "string",
          "pattern": "^#(?:[0-9a-fA-F]{6}|[0-9a-fA-F]{8})$"
        },
        "controlThumb": {
          "type": "string",
          "pattern": "^#(?:[0-9a-fA-F]{6}|[0-9a-fA-F]{8})$"
        },
        "sidebarBackground": {
          "type": "string",
          "pattern": "^#(?:[0-9a-fA-F]{6}|[0-9a-fA-F]{8})$"
        },
        "sidebarText": {
          "type": "string",
          "pattern": "^#(?:[0-9a-fA-F]{6}|[0-9a-fA-F]{8})$"
        },
        "sidebarTextStrong": {
          "type": "string",
          "pattern": "^#(?:[0-9a-fA-F]{6}|[0-9a-fA-F]{8})$"
        },
        "sidebarTextMuted": {
          "type": "string",
          "pattern": "^#(?:[0-9a-fA-F]{6}|[0-9a-fA-F]{8})$"
        },
        "sidebarBorder": {
          "type": "string",
          "pattern": "^#(?:[0-9a-fA-F]{6}|[0-9a-fA-F]{8})$"
        },
        "sidebarHover": {
          "type": "string",
          "pattern": "^#(?:[0-9a-fA-F]{6}|[0-9a-fA-F]{8})$"
        },
        "sidebarSelected": {
          "type": "string",
          "pattern": "^#(?:[0-9a-fA-F]{6}|[0-9a-fA-F]{8})$"
        },
        "sidebarSelectedBorder": {
          "type": "string",
          "pattern": "^#(?:[0-9a-fA-F]{6}|[0-9a-fA-F]{8})$"
        },
        "sidebarSelectedShadow": {
          "type": "string",
          "pattern": "^#(?:[0-9a-fA-F]{6}|[0-9a-fA-F]{8})$"
        },
        "popoverBackground": {
          "type": "string",
          "pattern": "^#(?:[0-9a-fA-F]{6}|[0-9a-fA-F]{8})$"
        },
        "overlaySoftSurface": {
          "type": "string",
          "pattern": "^#(?:[0-9a-fA-F]{6}|[0-9a-fA-F]{8})$"
        },
        "overlayHoverBackground": {
          "type": "string",
          "pattern": "^#(?:[0-9a-fA-F]{6}|[0-9a-fA-F]{8})$"
        },
        "scrim": {
          "type": "string",
          "pattern": "^#(?:[0-9a-fA-F]{6}|[0-9a-fA-F]{8})$"
        },
        "radiusSmall": {
          "type": "string",
          "pattern": "^(?:[0-9]|1\\d|2[0-4])(?:\\.\\d+)?px$",
          "description": "Corner radius from 0px to 24px."
        },
        "radiusMedium": {
          "type": "string",
          "pattern": "^(?:[0-9]|1\\d|2[0-4])(?:\\.\\d+)?px$",
          "description": "Corner radius from 0px to 24px."
        },
        "radiusLarge": {
          "type": "string",
          "pattern": "^(?:[0-9]|1\\d|2[0-4])(?:\\.\\d+)?px$",
          "description": "Corner radius from 0px to 24px."
        },
        "radiusFull": {
          "type": "string",
          "pattern": "^(?:0|[1-9]\\d{0,3})(?:\\.\\d+)?px$",
          "description": "Corner radius from 0px to 9999px."
        },
        "controlBorderWidth": {
          "type": "string",
          "pattern": "^(?:[0-3](?:\\.\\d+)?|4(?:\\.0+)?)px$",
          "description": "Border width from 0px to 4px."
        },
        "cardBorderWidth": {
          "type": "string",
          "pattern": "^(?:[0-3](?:\\.\\d+)?|4(?:\\.0+)?)px$",
          "description": "Border width from 0px to 4px."
        },
        "shadowExtraSmall": {
          "type": "string",
          "pattern": "^(?:none|(?:inset\\s+)?(?:0|-?\\d+(?:\\.\\d+)?px)(?:\\s+(?:0|-?\\d+(?:\\.\\d+)?px)){1,3}\\s+(?:#(?:[0-9a-fA-F]{6}|[0-9a-fA-F]{8})|rgba?\\(\\s*\\d{1,3}\\s*,\\s*\\d{1,3}\\s*,\\s*\\d{1,3}\\s*(?:,\\s*(?:0|1|0?\\.\\d+)\\s*)?\\))(?:\\s*,\\s*(?:inset\\s+)?(?:0|-?\\d+(?:\\.\\d+)?px)(?:\\s+(?:0|-?\\d+(?:\\.\\d+)?px)){1,3}\\s+(?:#(?:[0-9a-fA-F]{6}|[0-9a-fA-F]{8})|rgba?\\(\\s*\\d{1,3}\\s*,\\s*\\d{1,3}\\s*,\\s*\\d{1,3}\\s*(?:,\\s*(?:0|1|0?\\.\\d+)\\s*)?\\)))*)$",
          "description": "none or comma-separated box shadows: [inset] x y [blur] [spread] color."
        },
        "shadowSmall": {
          "type": "string",
          "pattern": "^(?:none|(?:inset\\s+)?(?:0|-?\\d+(?:\\.\\d+)?px)(?:\\s+(?:0|-?\\d+(?:\\.\\d+)?px)){1,3}\\s+(?:#(?:[0-9a-fA-F]{6}|[0-9a-fA-F]{8})|rgba?\\(\\s*\\d{1,3}\\s*,\\s*\\d{1,3}\\s*,\\s*\\d{1,3}\\s*(?:,\\s*(?:0|1|0?\\.\\d+)\\s*)?\\))(?:\\s*,\\s*(?:inset\\s+)?(?:0|-?\\d+(?:\\.\\d+)?px)(?:\\s+(?:0|-?\\d+(?:\\.\\d+)?px)){1,3}\\s+(?:#(?:[0-9a-fA-F]{6}|[0-9a-fA-F]{8})|rgba?\\(\\s*\\d{1,3}\\s*,\\s*\\d{1,3}\\s*,\\s*\\d{1,3}\\s*(?:,\\s*(?:0|1|0?\\.\\d+)\\s*)?\\)))*)$",
          "description": "none or comma-separated box shadows: [inset] x y [blur] [spread] color."
        },
        "shadowMedium": {
          "type": "string",
          "pattern": "^(?:none|(?:inset\\s+)?(?:0|-?\\d+(?:\\.\\d+)?px)(?:\\s+(?:0|-?\\d+(?:\\.\\d+)?px)){1,3}\\s+(?:#(?:[0-9a-fA-F]{6}|[0-9a-fA-F]{8})|rgba?\\(\\s*\\d{1,3}\\s*,\\s*\\d{1,3}\\s*,\\s*\\d{1,3}\\s*(?:,\\s*(?:0|1|0?\\.\\d+)\\s*)?\\))(?:\\s*,\\s*(?:inset\\s+)?(?:0|-?\\d+(?:\\.\\d+)?px)(?:\\s+(?:0|-?\\d+(?:\\.\\d+)?px)){1,3}\\s+(?:#(?:[0-9a-fA-F]{6}|[0-9a-fA-F]{8})|rgba?\\(\\s*\\d{1,3}\\s*,\\s*\\d{1,3}\\s*,\\s*\\d{1,3}\\s*(?:,\\s*(?:0|1|0?\\.\\d+)\\s*)?\\)))*)$",
          "description": "none or comma-separated box shadows: [inset] x y [blur] [spread] color."
        },
        "shadowLarge": {
          "type": "string",
          "pattern": "^(?:none|(?:inset\\s+)?(?:0|-?\\d+(?:\\.\\d+)?px)(?:\\s+(?:0|-?\\d+(?:\\.\\d+)?px)){1,3}\\s+(?:#(?:[0-9a-fA-F]{6}|[0-9a-fA-F]{8})|rgba?\\(\\s*\\d{1,3}\\s*,\\s*\\d{1,3}\\s*,\\s*\\d{1,3}\\s*(?:,\\s*(?:0|1|0?\\.\\d+)\\s*)?\\))(?:\\s*,\\s*(?:inset\\s+)?(?:0|-?\\d+(?:\\.\\d+)?px)(?:\\s+(?:0|-?\\d+(?:\\.\\d+)?px)){1,3}\\s+(?:#(?:[0-9a-fA-F]{6}|[0-9a-fA-F]{8})|rgba?\\(\\s*\\d{1,3}\\s*,\\s*\\d{1,3}\\s*,\\s*\\d{1,3}\\s*(?:,\\s*(?:0|1|0?\\.\\d+)\\s*)?\\)))*)$",
          "description": "none or comma-separated box shadows: [inset] x y [blur] [spread] color."
        },
        "shadowPopover": {
          "type": "string",
          "pattern": "^(?:none|(?:inset\\s+)?(?:0|-?\\d+(?:\\.\\d+)?px)(?:\\s+(?:0|-?\\d+(?:\\.\\d+)?px)){1,3}\\s+(?:#(?:[0-9a-fA-F]{6}|[0-9a-fA-F]{8})|rgba?\\(\\s*\\d{1,3}\\s*,\\s*\\d{1,3}\\s*,\\s*\\d{1,3}\\s*(?:,\\s*(?:0|1|0?\\.\\d+)\\s*)?\\))(?:\\s*,\\s*(?:inset\\s+)?(?:0|-?\\d+(?:\\.\\d+)?px)(?:\\s+(?:0|-?\\d+(?:\\.\\d+)?px)){1,3}\\s+(?:#(?:[0-9a-fA-F]{6}|[0-9a-fA-F]{8})|rgba?\\(\\s*\\d{1,3}\\s*,\\s*\\d{1,3}\\s*,\\s*\\d{1,3}\\s*(?:,\\s*(?:0|1|0?\\.\\d+)\\s*)?\\)))*)$",
          "description": "none or comma-separated box shadows: [inset] x y [blur] [spread] color."
        },
        "shadowDialog": {
          "type": "string",
          "pattern": "^(?:none|(?:inset\\s+)?(?:0|-?\\d+(?:\\.\\d+)?px)(?:\\s+(?:0|-?\\d+(?:\\.\\d+)?px)){1,3}\\s+(?:#(?:[0-9a-fA-F]{6}|[0-9a-fA-F]{8})|rgba?\\(\\s*\\d{1,3}\\s*,\\s*\\d{1,3}\\s*,\\s*\\d{1,3}\\s*(?:,\\s*(?:0|1|0?\\.\\d+)\\s*)?\\))(?:\\s*,\\s*(?:inset\\s+)?(?:0|-?\\d+(?:\\.\\d+)?px)(?:\\s+(?:0|-?\\d+(?:\\.\\d+)?px)){1,3}\\s+(?:#(?:[0-9a-fA-F]{6}|[0-9a-fA-F]{8})|rgba?\\(\\s*\\d{1,3}\\s*,\\s*\\d{1,3}\\s*,\\s*\\d{1,3}\\s*(?:,\\s*(?:0|1|0?\\.\\d+)\\s*)?\\)))*)$",
          "description": "none or comma-separated box shadows: [inset] x y [blur] [spread] color."
        },
        "shadowSpotlight": {
          "type": "string",
          "pattern": "^(?:none|(?:inset\\s+)?(?:0|-?\\d+(?:\\.\\d+)?px)(?:\\s+(?:0|-?\\d+(?:\\.\\d+)?px)){1,3}\\s+(?:#(?:[0-9a-fA-F]{6}|[0-9a-fA-F]{8})|rgba?\\(\\s*\\d{1,3}\\s*,\\s*\\d{1,3}\\s*,\\s*\\d{1,3}\\s*(?:,\\s*(?:0|1|0?\\.\\d+)\\s*)?\\))(?:\\s*,\\s*(?:inset\\s+)?(?:0|-?\\d+(?:\\.\\d+)?px)(?:\\s+(?:0|-?\\d+(?:\\.\\d+)?px)){1,3}\\s+(?:#(?:[0-9a-fA-F]{6}|[0-9a-fA-F]{8})|rgba?\\(\\s*\\d{1,3}\\s*,\\s*\\d{1,3}\\s*,\\s*\\d{1,3}\\s*(?:,\\s*(?:0|1|0?\\.\\d+)\\s*)?\\)))*)$",
          "description": "none or comma-separated box shadows: [inset] x y [blur] [spread] color."
        }
      }
    }
  }
}
